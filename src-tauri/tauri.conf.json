{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delikan",
  "version": "0.2.0",
  "identifier": "com.peymil.delikan",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Delikan - Playlist Downloader",
        "width": 720,
        "height": 600,
        "minWidth": 560,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
